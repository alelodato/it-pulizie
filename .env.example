# Copia questo file in .env.local (in locale) o imposta le variabili
# nel pannello dell'hosting. Non inserire mai valori reali in questo file.

# Chiave di accesso Web3Forms (usata dal modulo preventivo in home
# e dal modulo sopralluogo della landing condomini)
NEXT_PUBLIC_WEB3FORMS_KEY=

# ID del contenitore Google Tag Manager (formato GTM-XXXXXXX).
# Se vuota, GTM e Consent Mode non vengono caricati.
NEXT_PUBLIC_GTM_ID=
