# Copia questo file in .env.local (in locale) o imposta le variabili
# nel pannello dell'hosting. Non inserire mai valori reali in questo file.

# Chiave di accesso Web3Forms (usata dal modulo preventivo in home
# e dal modulo sopralluogo della landing condomini)
NEXT_PUBLIC_WEB3FORMS_KEY=

# ID del contenitore Google Tag Manager (formato GTM-XXXXXXX).
# Se vuota, GTM e Consent Mode non vengono caricati.
NEXT_PUBLIC_GTM_ID=

# --- Statistiche anonime (Supabase) — solo lato server, MAI con prefisso NEXT_PUBLIC_ ---

# URL base del progetto Supabase (Project Settings > Data API), es. https://abcd1234.supabase.co
# Senza slash finale e senza /rest/v1.
SUPABASE_URL=

# Chiave secret del progetto (Project Settings > API Keys > Secret keys, inizia con sb_secret_).
# Bypassa la RLS: non va mai esposta nel browser.
SUPABASE_SERVICE_ROLE_KEY=

# Password della dashboard /statistiche: almeno 16 caratteri, comoda da digitare sul telefono.
STATS_PASSWORD=

# Segreto per firmare il cookie di accesso alla dashboard (almeno 32 caratteri). Per generarlo:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STATS_SECRET=
